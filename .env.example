# Reference only. Run ./webnote.sh init URL to generate a private .env and token.
WEBNOTE_IMAGE=webnote:portable
WEBNOTE_PUBLIC_URL=https://webnote.example.com
WEBNOTE_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_GENERATED_BY_WEBNOTE_INIT
WEBNOTE_BIND_PORT=8765
WEBNOTE_PROJECT=webnote
WEBNOTE_MAX_BYTES=104857600
